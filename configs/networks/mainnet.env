# Prismo mainnet ("Prismo Glass") — canonical network values.
# Populated 2026-10-09 from the mainnet deploy output (chain created on L1
# 2026-10-07, RollupManager deploy block 26136887, createRollup block 26137324)
# and cross-checked against the live reference RPC/sequencer config.
# Source these into deploy targets via NETWORK=mainnet.

NETWORK=mainnet

# --- L2 ---
L2_CHAIN_ID=328
L2_CHAIN_NAME=dynamic-glass

# --- L1 ---
L1_CHAIN_ID=1
L1_CHAIN_NAME=mainnet
# RollupManager deploy block — the L1 syncer scans from here (same semantics as
# testnet: the manager's deploy block, not the later createRollup block).
L1_FIRST_BLOCK=26136887

# --- L1 contracts ---
# ROLLUP_CONTRACT feeds both --zkevm.address-rollup and --zkevm.address-zkevm.
# In cdk-erigon these MUST be the RollupManager (PolygonRollupManager), not the
# per-rollup PolygonZkEVMEtrog. See testnet.env.
ROLLUP_CONTRACT=0xC2cBC231C486f7732473dD435a60f77e151d227d
ROLLUP_MANAGER=0xC2cBC231C486f7732473dD435a60f77e151d227d
# PolygonZkEVMEtrog consensus contract for rollupID 1 (informational; not a cdk-erigon flag).
ROLLUP_ETROG=0x261ECc4303b184F08bB6bDb43d653Ba4B65Ac956
GER_MANAGER=0xf33FdfB61DAD1a19517DadceD33c6F39e5230C71
# GAS_TOKEN is the L1 gas-token address fed to --zkevm.l1-matic-contract-address.
# On mainnet this is the 18-decimal USDC18Wrapper over canonical USDC
# (0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48) — NOT raw 6-decimal USDC.
# Registering raw USDC would break gas accounting by 10^12.
GAS_TOKEN=0xCB7B19F31EDda9e857899f99aFd732542079146f
# SEQUENCER_EOA feeds --zkevm.address-sequencer: the L2 coinbase / batch identity
# inside the datastream. The *on-chain* trustedSequencer that sends sequenceBatches
# txs on L1 is the dedicated sequence-sender EOA (TRUSTED_SEQUENCER_L1, informational
# — watchtowers filter L1 sequencing txs by it; not a cdk-erigon flag).
SEQUENCER_EOA=0x56Ea07AEf738B2aEa5073Bd9fd236cde08849783
ADMIN_EOA=0x56Ea07AEf738B2aEa5073Bd9fd236cde08849783
TRUSTED_SEQUENCER_L1=0x12eda12aA4D0569Ef96029886E479fa7E9ae41d6
BRIDGE_L1=0xB6F289768b02dB5983E41D2BeA04E23e356fEbA4
BRIDGE_L2=0xB6F289768b02dB5983E41D2BeA04E23e356fEbA4

# --- Sync / datastream ---
# Public datastream (raw TCP), served by the relay tier in front of the
# sequencer — same design as testnet (see testnet.env for the relay-backfill
# note). Check reachability with: nc -z datastream.prismo.network 6900
DATASTREAM_HOST=datastream.prismo.network
DATASTREAM_PORT=6900
DATASTREAM_VERSION=2
ROLLUP_ID=1

# --- Public endpoints ---
PUBLIC_RPC_URL=https://rpc.prismo.network
# cdk-erigon RPC mode HARD-REQUIRES --zkevm.l2-sequencer-rpc-url (panics without
# it). It MUST be the TRUSTED SEQUENCER's own RPC, not the public RPC tier:
# nodes resolve the chain head via zkevm_getLatestDataStreamBlock against this
# URL and trust any successful answer — the RPC tier answers 0x0 without
# erroring, wedging external nodes at block 0 (verified live on testnet
# 2026-07-07 and re-verified against rpc.prismo.network 2026-10-09).
SEQUENCER_RPC_URL=https://sequencer.prismo.network
# WS shares the RPC hostname; the ALB routes on the `Upgrade: websocket` header
# (no /ws path).
PUBLIC_WS_URL=wss://rpc.prismo.network
BRIDGE_API_URL=https://bridge.prismo.network
EXPLORER_URL=https://explorer.prismo.network
# No faucet on mainnet — gas is real USDC bridged in from Ethereum.
FAUCET_URL=n/a
# Mainnet snapshots are not published yet (the chain is young; sync from
# genesis). The host below is where they will appear; docs/03-snapshots.md
# tracks the status.
SNAPSHOTS_BASE=https://snapshots.prismo.network
SNAPSHOTS_INDEX=https://snapshots.prismo.network/index.json

# --- L1 sync clients (Ethereum mainnet) ---
L1_NETWORK_FLAG=--mainnet
L1_CHECKPOINT_SYNC_URL=https://beaconstate.ethstaker.cc
