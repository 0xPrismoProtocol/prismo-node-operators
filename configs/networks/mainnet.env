# Prismo mainnet — canonical network values.
# All TBD until mainnet contracts are deployed and the chain is live.
# Populate from the mainnet deploy output (the Prismo core team manages contract deployment).
# Source these into deploy targets via NETWORK=mainnet.

NETWORK=mainnet

# --- L2 ---
L2_CHAIN_ID=TBD
L2_CHAIN_NAME=TBD

# --- L1 ---
L1_CHAIN_ID=1
L1_CHAIN_NAME=mainnet
L1_FIRST_BLOCK=TBD

# --- L1 contracts ---
ROLLUP_CONTRACT=TBD
ROLLUP_MANAGER=TBD
# PolygonZkEVMEtrog consensus contract (informational; not a cdk-erigon flag). See testnet.env.
ROLLUP_ETROG=TBD
GER_MANAGER=TBD
# GAS_TOKEN is the L1 gas-token address fed to --zkevm.l1-matic-contract-address.
# On the USDC chain this is the 18-decimal USDC18Wrapper, NOT raw 6-decimal USDC
# (0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48). Registering raw USDC would break
# gas accounting by 10^12. Populate with the wrapper address after rollup creation.
GAS_TOKEN=TBD
SEQUENCER_EOA=TBD
ADMIN_EOA=TBD
# On-chain trustedSequencer (L1 sequenceBatches sender); informational, see testnet.env.
TRUSTED_SEQUENCER_L1=TBD
BRIDGE_L1=TBD
BRIDGE_L2=TBD

# --- Sync / datastream ---
DATASTREAM_HOST=datastream.mainnet.prismo.example
DATASTREAM_PORT=6900
DATASTREAM_VERSION=2
ROLLUP_ID=TBD

# --- Public endpoints ---
PUBLIC_RPC_URL=https://rpc.prismo.example
SEQUENCER_RPC_URL=TBD
PUBLIC_WS_URL=wss://rpc.prismo.example/ws
BRIDGE_API_URL=https://bridge.prismo.example
EXPLORER_URL=https://explorer.prismo.example
FAUCET_URL=n/a
SNAPSHOTS_BASE=https://snapshots.prismo.example
SNAPSHOTS_INDEX=https://snapshots.prismo.example/index.json

# --- L1 sync clients (Ethereum mainnet) ---
L1_NETWORK_FLAG=--mainnet
L1_CHECKPOINT_SYNC_URL=https://beaconstate.ethstaker.cc
