# Prismo testnet — canonical network values.
# Mirrors the canonical chain config.
# Source these into deploy targets via NETWORK=testnet.

NETWORK=testnet

# --- L2 ---
L2_CHAIN_ID=101001000
L2_CHAIN_NAME=dynamic-glassnet

# --- L1 ---
L1_CHAIN_ID=11155111
L1_CHAIN_NAME=sepolia
L1_FIRST_BLOCK=11147580

# --- L1 contracts ---
# ROLLUP_CONTRACT feeds both --zkevm.address-rollup and --zkevm.address-zkevm.
# In cdk-erigon these MUST be the RollupManager (PolygonRollupManager), not the
# per-rollup PolygonZkEVMEtrog. Mirrors the canonical chain config's address-zkevm/address-rollup.
ROLLUP_CONTRACT=0x920A41e4718639f0629407c9C14b0CaC9A266EF6
ROLLUP_MANAGER=0x920A41e4718639f0629407c9C14b0CaC9A266EF6
# PolygonZkEVMEtrog consensus contract for rollupID 1 (informational; not a cdk-erigon flag).
ROLLUP_ETROG=0xFfA25304376eE1274ff6A348400C03f444F22B95
GER_MANAGER=0x8D33cC75066Bcb7A1f584AB77a59Bb97F1bf37BF
GAS_TOKEN=0xFB42879859F8d31089Ea6A9eBcA6996914aD9F9b
# SEQUENCER_EOA feeds --zkevm.address-sequencer: the L2 coinbase / batch identity
# inside the datastream. The *on-chain* trustedSequencer that sends sequenceBatches
# txs on L1 is the dedicated sequence-sender EOA (TRUSTED_SEQUENCER_L1, informational
# — watchtowers filter L1 sequencing txs by it; not a cdk-erigon flag).
SEQUENCER_EOA=0x691E2b6E666827BC87589cb0fA0BA772fd7Ea795
ADMIN_EOA=0x691E2b6E666827BC87589cb0fA0BA772fd7Ea795
TRUSTED_SEQUENCER_L1=0xd72FF0b50966AB4886fA59cbbfB55dafe21C1C08
BRIDGE_L1=0xd7d4F6BFD45C3EaEFde6fAEc0920fBC7E5a71D0d
BRIDGE_L2=0xd7d4F6BFD45C3EaEFde6fAEc0920fBC7E5a71D0d

# --- Sync / datastream ---
# Public datastream (raw TCP), served by a relay tier — LIVE (gate-verified
# 2026-07-07: full genesis->head sync + zero head lag from an external node).
# Note: a brand-new relay replica backfills the stream at ~60 entries/s; expect
# a stalled datastream for a few hours after the operator scales relays.
DATASTREAM_HOST=datastream.glassnet.prismo.network
DATASTREAM_PORT=6900
DATASTREAM_VERSION=2
ROLLUP_ID=1

# --- Public endpoints (live) ---
PUBLIC_RPC_URL=https://rpc.glassnet.prismo.network
# cdk-erigon RPC mode HARD-REQUIRES --zkevm.l2-sequencer-rpc-url (panics without
# it). It MUST be the TRUSTED SEQUENCER's own RPC, not the public RPC tier:
# nodes resolve the chain head via zkevm_getLatestDataStreamBlock against this
# URL and trust any successful answer — the RPC tier answers 0x0 without
# erroring, wedging external nodes at block 0 (verified live 2026-07-07).
SEQUENCER_RPC_URL=https://sequencer.glassnet.prismo.network
# WS shares the RPC hostname; the ALB routes on the `Upgrade: websocket` header
# (no /ws path).
PUBLIC_WS_URL=wss://rpc.glassnet.prismo.network
BRIDGE_API_URL=https://bridge.glassnet.prismo.network
EXPLORER_URL=https://explorer.glassnet.prismo.network
FAUCET_URL=https://faucet.glassnet.prismo.network
# Weekly (Sun ~07:00 UTC); newest at ${SNAPSHOTS_BASE}/latest.json.
SNAPSHOTS_BASE=https://snapshots.glassnet.prismo.network
SNAPSHOTS_INDEX=https://snapshots.glassnet.prismo.network/index.json

# --- Defaults for L1 sync clients (used by full-node compose) ---
L1_NETWORK_FLAG=--sepolia
L1_CHECKPOINT_SYNC_URL=https://beaconstate-sepolia.chainsafe.io
