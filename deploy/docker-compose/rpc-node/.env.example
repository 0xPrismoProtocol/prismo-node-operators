# Network selection. Loads the matching configs/networks/<NETWORK>.env.
NETWORK=testnet

# Your L1 RPC URL. MUST serve historical eth_getLogs back to L1_FIRST_BLOCK —
# the L1 syncer scans sequencing events from rollup genesis. Free-tier gotchas
# seen in the wild: publicnode 403s archive getLogs without a token; 1rpc caps
# getLogs at 50 blocks. https://sepolia.drpc.org worked free at gate-time;
# a keyed Alchemy/Infura endpoint or self-hosted geth+lighthouse is sturdier.
#   testnet: a Sepolia endpoint (eth_getLogs back to block 11147580)
#   mainnet: an Ethereum endpoint (eth_getLogs back to block 26136887)
L1_RPC_URL=https://your-l1-provider.example/your-key

# Optional overrides — uncomment to override the canonical network values
# from configs/networks/<NETWORK>.env. Useful for staging or private hosts.
# DATASTREAM_HOST=datastream.glassnet.prismo.network   # (mainnet: datastream.prismo.network)
# DATASTREAM_PORT=6900
