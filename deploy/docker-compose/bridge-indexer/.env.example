NETWORK=testnet

# L1 RPC matching NETWORK (Sepolia for testnet, Ethereum for mainnet).
L1_RPC_URL=https://your-l1-provider.example/your-key

# L2 RPC — point at your own RPC node, on the same network.
L2_RPC_URL=http://host.docker.internal:8545

# REQUIRED. Generate: openssl rand -base64 32
DB_PASS=change-me
