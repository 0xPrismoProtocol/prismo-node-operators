# Network selection. Loads configs/networks/<NETWORK>.env (Sepolia for testnet,
# Ethereum for mainnet). Determines both the L1 client (geth + lighthouse)
# network flag and all Prismo contract addresses.
NETWORK=testnet

# No external L1 RPC needed — geth + lighthouse run alongside.
# Reserve this file for per-host overrides:
# DATASTREAM_HOST=...
# L1_BLOCK_RANGE=2000   # eth_getLogs span; your own geth handles 2000 fine
