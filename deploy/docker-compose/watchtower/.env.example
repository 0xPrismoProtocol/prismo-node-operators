NETWORK=testnet

# L1 RPC URL.
#   testnet: a Sepolia endpoint
#   mainnet: an Ethereum endpoint
L1_RPC_URL=https://your-l1-provider.example/your-key

# L2 full-node URL the watchtower will compare against.
# Must follow the SAME network as NETWORK above.
L2_RPC_URL=http://host.docker.internal:8545

# At least one alert sink recommended.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
